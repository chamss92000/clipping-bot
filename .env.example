# ---------------------------------------------------------------------------
# clipping-bot — variables d'environnement
# Copier en `.env` pour le dev local. En CI, ces valeurs viennent des
# secrets GitHub Actions (voir .github/workflows/pipeline.yml).
# ---------------------------------------------------------------------------

# --- Bloc 1 : Détection ---
YOUTUBE_API_KEY=
TWITCH_CLIENT_ID=
TWITCH_CLIENT_SECRET=

# --- Bloc 4 : Viral (Gemini) ---
GEMINI_API_KEY=

# --- Bloc 2 : Storage Google Drive (OAuth utilisateur = budget 0€) ---
# Méthode recommandée : OAuth. Un Service Account n'a PAS de quota sur un Drive
# grand public (403 storageQuotaExceeded) — OAuth fait que les fichiers
# t'appartiennent et comptent sur tes 15 Go.
#
# LOCAL : place le JSON "Desktop app" OAuth sous ./oauth_client.json puis lance
#         `python -m src.storage.authorize` (consentement navigateur une fois).
GOOGLE_OAUTH_CLIENT_FILE=./oauth_client.json
GOOGLE_OAUTH_TOKEN_FILE=./token.json
#
# CI (headless) : renseigne ces 3 valeurs (fournies par authorize.py) en secrets.
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
GOOGLE_OAUTH_REFRESH_TOKEN=
#
# Dossier racine Drive (OPTIONNEL avec OAuth : créé auto sinon, nom ci-dessous).
GOOGLE_DRIVE_FOLDER_ID=
DRIVE_ROOT_FOLDER_NAME=clipping-bot
#
# Fallback Service Account (uniquement si tu as un Shared Drive Workspace) :
GOOGLE_DRIVE_CREDENTIALS=
GOOGLE_DRIVE_CREDENTIALS_FILE=

# --- Bloc 7 : Publication ---
UPLOADPOST_API_KEY=
UPLOADPOST_USER=

# --- Tuning optionnel (valeurs par défaut dans config/settings.py) ---
# LOG_LEVEL=INFO
# YOUTUBE_REGION=FR
# TWITCH_MIN_VIEWERS=3000
# MAX_CANDIDATES=20
# DRY_RUN=false
